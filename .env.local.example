# Copy this file to .env.local, then fill DEEPSEEK_API_KEY with a newly rotated key.
LLM_BACKEND=deepseek
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_THINKING_MODE=disabled
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_MAX_RETRIES=2
CHROMA_MODE=http
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001
CHROMA_COLLECTION=cardio_evidence
MEMORY_COLLECTION=cardio_memory_v2
EMBEDDING_BACKEND=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_REVISION=main
EMBEDDING_BATCH_SIZE=8
SEMANTIC_MIN_SCORE=0.78
MODEL_CONCURRENCY=2
REQUEST_TIMEOUT_SECONDS=180
REDIS_URL=
PUBMED_ENABLED=false
CPUBMED_URL=

# Agentic tools. No cloud OCR; remote search receives de-identified medical terms.
AGENTIC_ENABLED=true
MCP_ENABLED=true
MCP_BASE_URL=http://127.0.0.1:8000/mcp/
NETWORK_ENABLED=true
PATIENT_EDUCATION_ENABLED=true
# Resolves hostnames via Cloudflare DoH, then pins/checks public IPs. Use system for ordinary DNS.
NETWORK_DNS_MODE=public_doh
TAVILY_API_KEY=
TOOL_MAX_CALLS=8
TOOL_CONCURRENCY=2
TOOL_TIMEOUT_SECONDS=25
ATTACHMENT_TTL_SECONDS=86400
ATTACHMENT_TIMEOUT_SECONDS=120
# Optional: MCP_SERVERS_FILE=config/mcp_servers.local.json

# Low-memory staged construction; existing local secrets stay unchanged.
VECTOR_WRITE_BATCH_SIZE=128
BUILD_MIN_FREE_MEMORY_GIB=2
BUILD_MAX_RSS_GIB=3
BUILD_START_FREE_DISK_GIB=10
BUILD_MIN_FREE_DISK_GIB=5
TRANSLATION_TTL_SECONDS=86400
